---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	projectName?: string;
}

const {
	title = 'Coval Perú · ISO 27001:2022 | Formulación y Evaluación de Proyectos TI',
	description = 'Diagnóstico de Brechas (Gap Analysis) y Plan de Adecuación de Infraestructura y Controles Críticos bajo ISO/IEC 27001:2022 - Coval Servicios Financieros (Sede Perú)',
	projectName = 'Coval Perú · ISO 27001',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#fafaf9] text-neutral-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen antialiased selection:bg-neutral-800 selection:text-white text-neutral-800 font-sans">
		<!-- Top Progress Indicator -->
		<div id="progress-bar" class="fixed top-0 left-0 h-1 bg-neutral-800 z-50 transition-all duration-75 w-0"></div>

		<!-- Minimal Header -->
		<header class="border-b border-neutral-200 bg-white/90 backdrop-blur sticky top-0 z-40">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 h-13 flex items-center justify-between">
				<div class="flex items-center gap-2 text-xs font-medium text-neutral-600">
					<a href="/" class="font-bold text-neutral-900 hover:text-neutral-700 transition-colors">
						Coval Perú
					</a>
					<span class="text-neutral-300">/</span>
					<span class="text-neutral-600 truncate">ISO 27001:2022</span>
				</div>

				<nav class="flex items-center gap-4 text-xs">
					<a href="#sec-info" class="text-neutral-600 hover:text-neutral-950 transition-colors">Empresa</a>
					<a href="#sec-eef" class="text-neutral-600 hover:text-neutral-950 transition-colors">EEF Internos</a>
					<a href="#sec-infraestructura" class="hidden sm:inline text-neutral-600 hover:text-neutral-950 transition-colors">Infraestructura</a>
					<a href="#sec-proyecto" class="text-neutral-800 font-medium hover:text-neutral-950 underline underline-offset-4 decoration-neutral-300">Proyecto</a>
				</nav>
			</div>
		</header>

		<!-- Content Slot -->
		<slot />

		<!-- Minimal Footer -->
		<footer class="border-t border-neutral-200 bg-white py-8 mt-16 text-xs text-neutral-500">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
				<div>
					<span class="font-medium text-neutral-800">Coval Servicios Financieros (Sede Perú)</span>
					<span class="mx-1.5 text-neutral-300">·</span>
					<span>Formulación y Evaluación de Proyectos TI</span>
				</div>
				<span>ISO/IEC 27001:2022</span>
			</div>
		</footer>

		<script>
			window.addEventListener('scroll', () => {
				const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				const bar = document.getElementById('progress-bar');
				if (bar) bar.style.width = scrolled + '%';
			});
		</script>
	</body>
</html>
