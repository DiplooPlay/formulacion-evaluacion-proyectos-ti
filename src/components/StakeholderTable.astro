---
// Registro formal de Interesados (Stakeholder Register) bajo estándares PMBOK

interface Stakeholder {
	id: string;
	name: string;
	role: string;
	area: string;
	type: 'Interno' | 'Externo';
	power: 'Alto' | 'Bajo';
	interest: 'Alto' | 'Bajo';
	expectation: string;
	strategy: string;
}

const stakeholders: Stakeholder[] = [
	{
		id: "STK-01",
		name: "CISO Regional",
		role: "Seguridad de la Información (Holding/Colombia)",
		area: "Seguridad Corporativa",
		type: "Interno",
		power: "Alto",
		interest: "Alto",
		expectation: "Garantizar la homologación con la ISO 27001 implementada en Colombia y evitar brechas de seguridad física en la sede Lima.",
		strategy: "Gestionar atentamente: Validar entregables técnicos con las políticas del holding y mantener comunicación periódica sobre avances."
	},
	{
		id: "STK-02",
		name: "Katherine Reyes Warthon",
		role: "Gerente General (Perú)",
		area: "Dirección Ejecutiva Lima",
		type: "Interno",
		power: "Alto",
		interest: "Bajo",
		expectation: "Cumplimiento formal y austeridad presupuestal. Requiere que la inversión en seguridad tenga retorno justificado y bajo costo.",
		strategy: "Mantener satisfecha: Presentar propuestas técnico-económicas de bajo costo y alto impacto (costo-beneficio directo en mitigación)."
	},
	{
		id: "STK-03",
		name: "Wilder",
		role: "Líder de TI / Soporte Perú (Contraparte Técnica)",
		area: "Área de TI Local (2 colaboradores)",
		type: "Interno",
		power: "Bajo",
		interest: "Alto",
		expectation: "Resolver la vulnerabilidad del cuarto de redes (huellero y CCTV) sin sobrecargar el soporte diario ni generar reprocesos.",
		strategy: "Mantener informado / Participación activa: Sesiones continuas de relevamiento técnico y validación mediante Juicio de Expertos."
	},
	{
		id: "STK-04",
		name: "Jefe de Operaciones Factoring",
		role: "Operaciones y Mesa de Créditos",
		area: "Negocio / Operaciones",
		type: "Interno",
		power: "Bajo",
		interest: "Alto",
		expectation: "Cero impacto o interrupción en el sistema de factoring durante horario de liquidación (9:00 a 18:00 hrs).",
		strategy: "Mantener informado: Coordinar ventanas de intervención técnica exclusivamente en horarios nocturnos o fines de semana."
	},
	{
		id: "STK-05",
		name: "Administración del Edificio",
		role: "Gestión de Facilidades e Instalaciones",
		area: "Administración Tercerizada (San Isidro)",
		type: "Externo",
		power: "Bajo",
		interest: "Bajo",
		expectation: "Cumplimiento de protocolos de acceso al edificio, permisos de contratistas y normas de seguridad en áreas comunes.",
		strategy: "Monitorear: Tramitar cartas de ingreso, seguros SCTR y permisos formales de perforación/cableado con antelación."
	},
	{
		id: "STK-06",
		name: "Proveedor de Seguridad Electrónica",
		role: "Contratista Especializado (CCTV / Biometría)",
		area: "Servicios Tecnológicos Externos",
		type: "Externo",
		power: "Bajo",
		interest: "Alto",
		expectation: "Especificaciones claras de hardware (lector biométrico, chapa magnética, cámaras IP) y aprobación de cotización.",
		strategy: "Mantener informado: Definir términos de referencia (TDR) precisos para cotización competitiva y supervisión de instalación."
	},
	{
		id: "STK-07",
		name: "Ente Certificador / Auditor ISO 27001",
		role: "Organismo Evaluador Externo de Conformidad",
		area: "Certificación y Auditoría",
		type: "Externo",
		power: "Alto",
		interest: "Bajo",
		expectation: "Evidencias objetivas y trazables del cumplimiento de los controles A.7.1 y A.7.2 del Anexo A de ISO/IEC 27001:2022.",
		strategy: "Mantener informado / Satisfecho: Diseñar la bitácora de accesos y la custodia física bajo estándares auditables."
	}
];
---

<div class="my-6 overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
	<div class="px-5 py-4 border-b border-neutral-200 bg-neutral-50/70 flex flex-wrap items-center justify-between gap-2">
		<div>
			<span class="text-[11px] font-mono uppercase tracking-wider text-neutral-500 font-semibold block">
				Evidencia Documental · PMBOK
			</span>
			<h3 class="text-sm sm:text-base font-bold text-neutral-900">
				A. Registro de Interesados (Stakeholder Register)
			</h3>
		</div>
		<span class="text-xs font-mono text-neutral-500 bg-white px-2.5 py-1 rounded border border-neutral-200">
			{stakeholders.length} Interesados Identificados
		</span>
	</div>

	<div class="overflow-x-auto">
		<table class="w-full text-left text-xs border-collapse">
			<thead>
				<tr class="bg-neutral-100/80 text-neutral-700 uppercase font-mono text-[10px] tracking-wider border-b border-neutral-200">
					<th class="p-3 w-16">ID</th>
					<th class="p-3">Nombre / Rol</th>
					<th class="p-3">Posición / Área</th>
					<th class="p-3 text-center">Tipo</th>
					<th class="p-3 text-center">Poder / Interés</th>
					<th class="p-3 min-w-[200px]">Expectativa / Requisito</th>
					<th class="p-3 min-w-[180px]">Estrategia PMBOK</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-neutral-200 text-neutral-700">
				{stakeholders.map((s) => (
					<tr class="hover:bg-neutral-50/70 transition-colors">
						<td class="p-3 font-mono font-bold text-neutral-900">{s.id}</td>
						<td class="p-3">
							<strong class="text-neutral-900 block">{s.name}</strong>
							<span class="text-[11px] text-neutral-500">{s.role}</span>
						</td>
						<td class="p-3 text-neutral-600">{s.area}</td>
						<td class="p-3 text-center">
							<span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${
								s.type === 'Interno' 
									? 'bg-blue-50 text-blue-700 border border-blue-200' 
									: 'bg-amber-50 text-amber-700 border border-amber-200'
							}`}>
								{s.type}
							</span>
						</td>
						<td class="p-3 text-center font-mono text-[11px]">
							<span class="block text-neutral-900">P: <strong>{s.power}</strong></span>
							<span class="block text-neutral-500">I: <strong>{s.interest}</strong></span>
						</td>
						<td class="p-3 text-neutral-600 leading-relaxed text-[11px]">
							{s.expectation}
						</td>
						<td class="p-3 text-neutral-700 leading-relaxed text-[11px]">
							{s.strategy}
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</div>
