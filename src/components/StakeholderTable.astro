---
// Registro formal de Interesados (Stakeholder Register) bajo estándares PMBOK

interface Stakeholder {
	id: string;
	name: string;
	role: string;
	area: string;
	type: 'Interno' | 'Externo';
	power: 'Alto' | 'Bajo';
	interest: 'Alto' | 'Bajo';
	expectation: string;
	strategy: string;
}

const stakeholders: Stakeholder[] = [
	{
		id: "STK-01",
		name: "CISO Regional",
		role: "Seguridad de la Información",
		area: "Holding / Colombia",
		type: "Interno",
		power: "Alto",
		interest: "Alto",
		expectation: "Homologación con la ISO 27001 implementada en Colombia y mitigación de brechas físicas en la sede Lima.",
		strategy: "Gestionar atentamente: Validar entregables técnicos con lineamientos del holding."
	},
	{
		id: "STK-02",
		name: "Marco Bravo Mences",
		role: "Gerente General (Perú)",
		area: "Dirección Ejecutiva Lima",
		type: "Interno",
		power: "Alto",
		interest: "Bajo",
		expectation: "Austeridad presupuestal, cumplimiento formal y justificación clara del costo-beneficio.",
		strategy: "Mantener satisfecha: Presentar cotizaciones de bajo costo y alto impacto en reducción de riesgos."
	},
	{
		id: "STK-03",
		name: "Wilder",
		role: "Líder de TI / Soporte Perú",
		area: "Área de TI Local (2 personas)",
		type: "Interno",
		power: "Bajo",
		interest: "Alto",
		expectation: "Solucionar la vulnerabilidad del cuarto de redes (huellero y CCTV) sin entorpecer el soporte diario.",
		strategy: "Mantener informado / Participación activa: Sesiones periódicas de relevamiento técnico."
	},
	{
		id: "STK-04",
		name: "Jefe de Operaciones Factoring",
		role: "Operaciones y Créditos",
		area: "Negocio Factoring",
		type: "Interno",
		power: "Bajo",
		interest: "Alto",
		expectation: "Disponibilidad continua del sistema en horario de liquidación financiera (9:00 a 18:00 hrs).",
		strategy: "Mantener informado: Restringir intervenciones técnicas a horarios nocturnos o fines de semana."
	},
	{
		id: "STK-05",
		name: "Administración del Edificio",
		role: "Gestión de Instalaciones",
		area: "Facilidades / San Isidro",
		type: "Externo",
		power: "Bajo",
		interest: "Bajo",
		expectation: "Cumplimiento de normas de ingreso de contratistas y permisos de trabajo en áreas comunes.",
		strategy: "Monitorear: Gestionar permisos de acceso y seguros con la debida anticipación."
	},
	{
		id: "STK-06",
		name: "Proveedor de Seguridad",
		role: "Contratista CCTV / Biometría",
		area: "Servicios Externos",
		type: "Externo",
		power: "Bajo",
		interest: "Alto",
		expectation: "Términos de referencia claros y especificaciones de hardware para cotización formal.",
		strategy: "Mantener informado: Coordinar requerimientos técnicos y supervisar instalación."
	}
];
---

<div class="my-6 overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
	<div class="px-5 py-3.5 border-b border-neutral-100 flex items-center justify-between">
		<h4 class="text-sm font-semibold text-neutral-900">
			Registro de Interesados
		</h4>
		<span class="text-xs text-neutral-400 font-mono">
			{stakeholders.length} Interesados
		</span>
	</div>

	<div class="overflow-x-auto">
		<table class="w-full text-left text-xs border-collapse">
			<thead>
				<tr class="bg-neutral-50/80 text-neutral-600 font-mono text-[11px] border-b border-neutral-200">
					<th class="p-3 w-16">ID</th>
					<th class="p-3">Nombre / Rol</th>
					<th class="p-3">Área</th>
					<th class="p-3 text-center">Tipo</th>
					<th class="p-3 text-center">Poder / Interés</th>
					<th class="p-3">Expectativa Principal</th>
					<th class="p-3">Estrategia</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-neutral-100 text-neutral-700">
				{stakeholders.map((s) => (
					<tr class="hover:bg-neutral-50/50 transition-colors">
						<td class="p-3 font-mono font-medium text-neutral-500">{s.id}</td>
						<td class="p-3">
							<span class="font-medium text-neutral-900 block">{s.name}</span>
							<span class="text-[11px] text-neutral-500">{s.role}</span>
						</td>
						<td class="p-3 text-neutral-600">{s.area}</td>
						<td class="p-3 text-center">
							<span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-mono ${
								s.type === 'Interno' 
									? 'bg-neutral-100 text-neutral-700' 
									: 'bg-neutral-100 text-neutral-600'
							}`}>
								{s.type}
							</span>
						</td>
						<td class="p-3 text-center font-mono text-[11px] text-neutral-600">
							{s.power} / {s.interest}
						</td>
						<td class="p-3 text-neutral-600 text-[11px] leading-relaxed max-w-[220px]">
							{s.expectation}
						</td>
						<td class="p-3 text-neutral-700 text-[11px] leading-relaxed max-w-[200px]">
							{s.strategy}
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</div>
