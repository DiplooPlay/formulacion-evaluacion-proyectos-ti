---
import data from '../data/actividades.json';
import ZoomableImageModal from './ZoomableImageModal.astro';
const { actividades, atributos, hitos } = data;
---

<div class="my-6 space-y-3">
	<!-- Selector de pestañas -->
	<div class="flex flex-nowrap items-center gap-1.5 p-1 bg-neutral-100 rounded-xl max-w-full overflow-x-auto border border-neutral-200/80">
		<button
			type="button"
			data-act-tab="tab-lista"
			class="act-tab-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150 bg-white text-neutral-900 shadow-xs border border-neutral-200/60 cursor-pointer"
		>
			Lista de actividades
		</button>
		<button
			type="button"
			data-act-tab="tab-atributos"
			class="act-tab-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150 text-neutral-600 hover:text-neutral-900 hover:bg-white/50 cursor-pointer"
		>
			Atributos de las actividades
		</button>
		<button
			type="button"
			data-act-tab="tab-hitos"
			class="act-tab-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150 text-neutral-600 hover:text-neutral-900 hover:bg-white/50 cursor-pointer"
		>
			Lista de hitos
		</button>
		<button
			type="button"
			data-act-tab="tab-diagrama"
			class="act-tab-btn shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150 text-neutral-600 hover:text-neutral-900 hover:bg-white/50 cursor-pointer"
		>
			Diagrama de red
		</button>
	</div>

	<!-- TAB 1: Lista de actividades -->
	<div id="tab-lista" class="act-tab-panel overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
		<div class="overflow-x-auto max-h-[500px]">
			<table class="w-full text-left text-xs border-collapse">
				<thead class="sticky top-0 z-10">
					<tr class="bg-neutral-50/95 text-neutral-700 font-mono text-[11px] border-b border-neutral-200 backdrop-blur-xs">
						<th class="p-3 w-20">Código</th>
						<th class="p-3 w-24">Paquete EDT</th>
						<th class="p-3 min-w-[200px]">Actividad</th>
						<th class="p-3 min-w-[280px]">Alcance del trabajo</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-neutral-100 text-neutral-700">
					{actividades.map((row) => (
						<tr class="hover:bg-neutral-50/50 transition-colors">
							<td class="p-3 font-mono font-medium text-neutral-900">{row[0]}</td>
							<td class="p-3 font-mono text-neutral-500">{row[1]}</td>
							<td class="p-3 font-medium text-neutral-800">{row[2]}</td>
							<td class="p-3 text-neutral-600 leading-relaxed">{row[3]}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>

	<!-- TAB 2: Atributos de las actividades -->
	<div id="tab-atributos" class="act-tab-panel hidden overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
		<div class="overflow-x-auto max-h-[500px]">
			<table class="w-full text-left text-xs border-collapse">
				<thead class="sticky top-0 z-10">
					<tr class="bg-neutral-50/95 text-neutral-700 font-mono text-[11px] border-b border-neutral-200 backdrop-blur-xs">
						<th class="p-3 w-20">Código</th>
						<th class="p-3 min-w-[140px]">Predecesoras</th>
						<th class="p-3 min-w-[140px]">Sucesoras</th>
						<th class="p-3 w-16">Relación</th>
						<th class="p-3 min-w-[180px]">Recursos</th>
						<th class="p-3 min-w-[180px]">Restricción</th>
						<th class="p-3 min-w-[180px]">Supuesto</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-neutral-100 text-neutral-700">
					{atributos.map((row) => (
						<tr class="hover:bg-neutral-50/50 transition-colors">
							<td class="p-3 font-mono font-medium text-neutral-900">{row[0]}</td>
							<td class="p-3 font-mono text-neutral-600">{row[1]}</td>
							<td class="p-3 font-mono text-neutral-600">{row[2]}</td>
							<td class="p-3 font-mono text-center text-neutral-500">{row[3]}</td>
							<td class="p-3 text-neutral-700">{row[4]}</td>
							<td class="p-3 text-neutral-600 leading-relaxed">{row[5]}</td>
							<td class="p-3 text-neutral-600 leading-relaxed">{row[6]}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>

	<!-- TAB 3: Lista de hitos -->
	<div id="tab-hitos" class="act-tab-panel hidden overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
		<div class="overflow-x-auto">
			<table class="w-full text-left text-xs border-collapse">
				<thead>
					<tr class="bg-neutral-50/95 text-neutral-700 font-mono text-[11px] border-b border-neutral-200">
						<th class="p-3 w-16">Hito</th>
						<th class="p-3 min-w-[240px]">Evento</th>
						<th class="p-3 min-w-[180px]">Se logra al terminar</th>
						<th class="p-3 w-24 text-center">Obligatorio</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-neutral-100 text-neutral-700">
					{hitos.map((row) => (
						<tr class="hover:bg-neutral-50/50 transition-colors">
							<td class="p-3 font-mono font-bold text-neutral-900">{row[0]}</td>
							<td class="p-3 font-medium text-neutral-800">{row[1]}</td>
							<td class="p-3 font-mono text-neutral-600">{row[2]}</td>
							<td class="p-3 text-center">
								{row[3].toLowerCase().includes('sí') || row[3].toLowerCase().includes('si') ? (
									<span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
										Sí
									</span>
								) : (
									<span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-neutral-100 text-neutral-600 border border-neutral-200">
										No
									</span>
								)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>

	<!-- TAB 4: Diagrama de red -->
	<div id="tab-diagrama" class="act-tab-panel hidden rounded-xl border border-neutral-200 bg-white p-3 sm:p-4 shadow-xs">
		<ZoomableImageModal
			src="/edt/diagrama-red.jpg"
			alt="Diagrama de red de actividades"
			modalAlt="Diagrama de red de actividades completo"
			ariaLabel="Ver diagrama de red completo"
			triggerClass="group relative overflow-hidden rounded-lg border border-neutral-150 bg-neutral-50/50 hover:border-neutral-400 transition-all duration-200 cursor-pointer"
			thumbBoxClass="relative flex items-center justify-center p-2 sm:p-3"
			thumbImgClass="max-h-[560px] w-auto max-w-full h-auto object-contain block mx-auto opacity-95 group-hover:opacity-100 group-hover:scale-[1.01] transition-all duration-300"
			modalImgClass="max-w-[92vw] max-h-[85vh] w-auto h-auto object-contain transition-transform duration-75 origin-center pointer-events-none select-none"
		/>
	</div>
</div>

<script>
	function initActividadesTabs() {
		const buttons = document.querySelectorAll('.act-tab-btn');
		const panels = document.querySelectorAll('.act-tab-panel');

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const target = btn.getAttribute('data-act-tab');
				if (!target) return;

				buttons.forEach((b) => {
					b.classList.remove('bg-white', 'text-neutral-900', 'shadow-xs', 'border', 'border-neutral-200/60');
					b.classList.add('text-neutral-600', 'hover:text-neutral-900', 'hover:bg-white/50');
				});
				btn.classList.add('bg-white', 'text-neutral-900', 'shadow-xs', 'border', 'border-neutral-200/60');
				btn.classList.remove('text-neutral-600', 'hover:text-neutral-900', 'hover:bg-white/50');

				panels.forEach((p) => {
					if (p.id === target) {
						p.classList.remove('hidden');
					} else {
						p.classList.add('hidden');
					}
				});
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initActividadesTabs);
	} else {
		initActividadesTabs();
	}
</script>
