---
interface SectionItem {
	id: string;
	num: string;
	title: string;
}

interface Props {
	sections?: SectionItem[];
}

const defaultSections: SectionItem[] = [
	{ id: "sec-1", num: "1", title: "Caso de negocio y diagnóstico situacional" },
	{ id: "sec-1-1", num: "1.1", title: "Reseña de Coval Servicios Financieros" },
	{ id: "sec-1-2", num: "1.2", title: "Diagnóstico de seguridad física del cuarto de redes" },
	{ id: "sec-2", num: "2", title: "Metodología y juicio de expertos" },
	{ id: "sec-2-1", num: "2.1", title: "Modelo de consultoría externa" },
	{ id: "sec-2-2", num: "2.2", title: "Aplicación del juicio de expertos" },
	{ id: "sec-3", num: "3", title: "Identificación y clasificación de interesados" },
	{ id: "sec-3-1", num: "3.1", title: "Matriz de poder e interés" },
	{ id: "sec-3-2", num: "3.2", title: "Registro de interesados" },
	{ id: "sec-4", num: "4", title: "Factores ambientales de la empresa (EEF)" },
	{ id: "sec-4-1", num: "4.1", title: "Organigrama y gobernanza regional" },
	{ id: "sec-4-2", num: "4.2", title: "Condiciones de infraestructura y restricciones" },
	{ id: "sec-5", num: "5", title: "Diagramas" },
	{ id: "sec-5-1", num: "5.1", title: "Arbol de problema" },
	{ id: "sec-5-2", num: "5.2", title: "Arbol de objetivo" },
	{ id: "sec-6", num: "6", title: "Identificación y formulación de alternativas de intervención" },
	{ id: "sec-6-1", num: "6.1", title: "Identificación de acciones por medio fundamental" },
	{ id: "sec-6-2", num: "6.2", title: "Identificación y organización de acciones en proyectos alternativos" },
	{ id: "sec-7", num: "7", title: "Evaluación y justificación de alternativas" },
	{ id: "sec-7-1", num: "7.1", title: "Evaluación de alternativas y justificación" },
	{ id: "sec-7-2", num: "7.2", title: "Análisis costo-beneficio y costo-efectividad" },
];

const { sections = defaultSections } = Astro.props;
---

<nav id="indice" class="my-8 p-5 bg-neutral-50 rounded-xl border border-neutral-200 text-neutral-800">
	<div class="flex items-center justify-between mb-3 pb-2 border-b border-neutral-200">
		<span class="text-xs font-semibold uppercase tracking-wider text-neutral-700">Índice del Documento</span>
		<span class="text-xs font-mono text-neutral-400">7 Secciones Clave</span>
	</div>
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 text-xs">
		{sections.map((s) => (
			<a
				href={`#${s.id}`}
				class="text-neutral-600 hover:text-neutral-950 py-1 transition-colors flex items-baseline gap-2 group"
			>
				<span class="text-neutral-400 group-hover:text-neutral-900 w-6 shrink-0 text-right font-mono">{s.num}.</span>
				<span class="truncate hover:underline underline-offset-2">{s.title}</span>
			</a>
		))}
	</div>
</nav>
