---
// Tabla de Análisis Costo-Efectividad y Presupuesto Comparativo
---

<div class="my-6 overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xs">
	<div class="overflow-x-auto">
		<table class="w-full text-left text-xs border-collapse">
			<thead>
				<tr class="bg-neutral-50/90 text-neutral-700 font-mono text-[11px] border-b border-neutral-200">
					<th class="p-3.5 min-w-[220px]">Rubro / Entregable</th>
					<th class="p-3.5 min-w-[200px]">Proyecto Alternativo 1 (Local)</th>
					<th class="p-3.5 min-w-[220px]">Proyecto Alternativo 2 (Enterprise IP)</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-neutral-150 text-neutral-700 leading-relaxed">
				<!-- Fila 1: Control de acceso -->
				<tr class="hover:bg-neutral-50/50 transition-colors">
					<td class="p-3.5 align-middle italic text-neutral-800">
						Control de acceso perimetral (A1.1a vs A1.1b)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 850</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Cerradura biométrica autónoma)</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 4,200</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Controlador IP + Lector RFID + Licencias)</span>
					</td>
				</tr>

				<!-- Fila 2: Confinamiento de hardware -->
				<tr class="hover:bg-neutral-50/50 transition-colors">
					<td class="p-3.5 align-middle italic text-neutral-800">
						Confinamiento de hardware (A2.1a vs A2.1b)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 2,400</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Gabinete cerrado 42U estándar)</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 8,500</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Rack inteligente microperforado + Chapa IP)</span>
					</td>
				</tr>

				<!-- Fila 3: Cableado, peinado y organizadores -->
				<tr class="hover:bg-neutral-50/50 transition-colors">
					<td class="p-3.5 align-middle italic text-neutral-800">
						Cableado, peinado y organizadores (A3.2)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 1,200</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Organizadores, patch cords, rotulado)</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 1,200</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Organizadores, patch cords, rotulado)</span>
					</td>
				</tr>

				<!-- Fila 4: Monitoreo, sensores y gobernanza -->
				<tr class="hover:bg-neutral-50/50 transition-colors">
					<td class="p-3.5 align-middle italic text-neutral-800">
						Monitoreo, sensores y gobernanza (A3.1 + A3.3)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 950</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Cámara IP, termohigrómetro, cofre llaves)</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 950</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Cámara IP, termohigrómetro, cofre llaves)</span>
					</td>
				</tr>

				<!-- Fila 5: Mano de obra e instalación -->
				<tr class="hover:bg-neutral-50/50 transition-colors">
					<td class="p-3.5 align-middle italic text-neutral-800">
						Mano de obra e instalación (Ventana nocturna)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 1,500</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Técnicos locales - 3 semanas)</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-medium text-neutral-900">S/ 3,800</span>
						<span class="text-neutral-500 italic text-[11px] block mt-0.5">(Integración de red, VLANs y soporte - 7 semanas)</span>
					</td>
				</tr>

				<!-- Fila 6: Costo Total de Inversión (CAPEX) -->
				<tr class="bg-neutral-50/90 font-medium border-t-2 border-neutral-300">
					<td class="p-3.5 align-middle font-bold text-neutral-900">
						Costo Total de Inversión (CAPEX)
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-bold text-emerald-700 text-sm">S/ 6,900</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-bold text-red-700 text-sm">S/ 18,650</span>
					</td>
				</tr>

				<!-- Fila 7: Tiempo estimado -->
				<tr class="bg-neutral-50/60 font-medium">
					<td class="p-3.5 align-middle font-bold text-neutral-900">
						Tiempo estimado
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-bold text-neutral-900">15-21 días</span>
					</td>
					<td class="p-3.5 align-middle">
						<span class="font-bold text-neutral-900">30-45 días</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
