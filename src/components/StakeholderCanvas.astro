---
// Matriz Minimalista de Clasificación Poder vs. Interés (PMBOK)
---

<div class="my-6 rounded-xl border border-neutral-200 bg-white p-6 shadow-xs">
	<!-- Header simple -->
	<div class="flex items-center justify-between mb-6 pb-3 border-b border-neutral-100">
		<h4 class="text-sm font-semibold text-neutral-900">
			Matriz Poder vs. Interés
		</h4>
		<span class="text-xs text-neutral-400 font-mono">
			Clasificación PMBOK
		</span>
	</div>

	<!-- Grilla 2x2 Minimalista con Ejes -->
	<div class="relative">
		<!-- Etiqueta Eje Y (Poder) -->
		<div class="text-[11px] font-mono text-neutral-400 mb-2 flex items-center justify-between">
			<span class="uppercase font-semibold tracking-wider text-neutral-500">Poder ↑</span>
			<span class="text-[10px] text-neutral-400">Alto / Bajo</span>
		</div>

		<!-- Cuadrícula 2x2 -->
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<!-- Cuadrante 1: Mantener Satisfecho (Alto Poder / Bajo Interés) -->
			<div class="p-4 rounded-lg bg-neutral-50/70 border border-neutral-200/80">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-neutral-900">
						Mantener Satisfecho
					</span>
					<span class="text-[10px] text-neutral-400 font-mono">
						Poder Alto · Interés Bajo
					</span>
				</div>
				<ul class="mt-3 space-y-1.5 text-xs text-neutral-700">
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-400">•</span>
						<span><strong>Marco Bravo Mences</strong> (Gerente General Perú)</span>
					</li>
				</ul>
				<p class="mt-3 text-[11px] text-neutral-500 leading-normal border-t border-neutral-200/60 pt-2">
					Prioriza control presupuestal y justificación económica.
				</p>
			</div>

			<!-- Cuadrante 2: Gestionar Atentamente (Alto Poder / Alto Interés) -->
			<div class="p-4 rounded-lg bg-neutral-50/70 border border-neutral-300">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-neutral-900">
						Gestionar Atentamente
					</span>
					<span class="text-[10px] text-neutral-500 font-mono font-medium">
						Poder Alto · Interés Alto
					</span>
				</div>
				<ul class="mt-3 space-y-1.5 text-xs text-neutral-700">
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-900">•</span>
						<span><strong>CISO Regional</strong> (Seguridad Holding / Colombia)</span>
					</li>
				</ul>
				<p class="mt-3 text-[11px] text-neutral-500 leading-normal border-t border-neutral-200/60 pt-2">
					Valida alineamiento con el SGSI corporativo y la ISO 27001.
				</p>
			</div>

			<!-- Cuadrante 3: Monitorear (Bajo Poder / Bajo Interés) -->
			<div class="p-4 rounded-lg bg-neutral-50/70 border border-neutral-200/80">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-neutral-900">
						Monitorear
					</span>
					<span class="text-[10px] text-neutral-400 font-mono">
						Poder Bajo · Interés Bajo
					</span>
				</div>
				<ul class="mt-3 space-y-1.5 text-xs text-neutral-700">
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-400">•</span>
						<span><strong>Administración del Edificio</strong> (San Isidro)</span>
					</li>
				</ul>
				<p class="mt-3 text-[11px] text-neutral-500 leading-normal border-t border-neutral-200/60 pt-2">
					Permisos de acceso físico y normas de facilidades en sede.
				</p>
			</div>

			<!-- Cuadrante 4: Mantener Informado (Bajo Poder / Alto Interés) -->
			<div class="p-4 rounded-lg bg-neutral-50/70 border border-neutral-200/80">
				<div class="flex items-center justify-between mb-2">
					<span class="text-xs font-semibold text-neutral-900">
						Mantener Informado
					</span>
					<span class="text-[10px] text-neutral-400 font-mono">
						Poder Bajo · Interés Alto
					</span>
				</div>
				<ul class="mt-3 space-y-1.5 text-xs text-neutral-700">
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-400">•</span>
						<span><strong>Wilder</strong> (Líder TI / Soporte Perú)</span>
					</li>
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-400">•</span>
						<span><strong>Jefe de Operaciones Factoring</strong> (Negocio)</span>
					</li>
					<li class="flex items-baseline gap-2">
						<span class="text-neutral-400">•</span>
						<span><strong>Proveedor de Seguridad Electrónica</strong></span>
					</li>
				</ul>
				<p class="mt-3 text-[11px] text-neutral-500 leading-normal border-t border-neutral-200/60 pt-2">
					Afectados directos por ventanas de corte y soporte operativo.
				</p>
			</div>
		</div>

		<!-- Etiqueta Eje X (Interés) -->
		<div class="text-[11px] font-mono text-neutral-400 mt-3 flex items-center justify-between">
			<span class="text-[10px]">Bajo</span>
			<span class="uppercase font-semibold tracking-wider text-neutral-500">Interés →</span>
			<span class="text-[10px]">Alto</span>
		</div>
	</div>
</div>
