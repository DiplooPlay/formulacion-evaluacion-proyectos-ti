---
interface Props {
	title: string;
	value: string;
	subtitle?: string;
	status?: 'positive' | 'neutral' | 'warning';
}

const {
	title,
	value,
	subtitle,
	status = 'positive',
} = Astro.props;

const statusStyles = {
	positive: 'text-emerald-700 bg-emerald-50 border-emerald-200',
	neutral: 'text-neutral-700 bg-neutral-50 border-neutral-200',
	warning: 'text-amber-700 bg-amber-50 border-amber-200',
};
---

<div class="rounded-xl border border-neutral-200 bg-white p-4 shadow-xs">
	<div class="text-xs font-medium text-neutral-500 mb-1">{title}</div>
	<div class="text-2xl font-bold font-mono text-neutral-900 tracking-tight">{value}</div>
	{subtitle && (
		<div class="mt-2 text-[11px] text-neutral-500 flex items-center gap-1.5">
			<span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-medium border ${statusStyles[status]}`}>
				{subtitle}
			</span>
		</div>
	)}
</div>
