---
// Visor del cronograma Gantt con miniatura y modal interactivo de zoom
import ZoomableImageModal from './ZoomableImageModal.astro';
---

<ZoomableImageModal
	src="/cronograma/gantt.png"
	alt="Cronograma Gantt"
	modalAlt="Cronograma Gantt Completo"
	ariaLabel="Ver cronograma Gantt completo"
	wrapperClass="my-6"
	triggerClass="group relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-2 sm:p-3 shadow-xs hover:border-neutral-400 transition-all duration-200 cursor-pointer"
	thumbBoxClass="relative overflow-hidden rounded-lg bg-neutral-100 flex items-center justify-center max-h-56"
	thumbImgClass="w-full h-auto object-cover object-left opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-300"
	modalImgClass="max-w-none transition-transform duration-75 origin-center pointer-events-none select-none max-h-[85vh] w-auto"
/>
